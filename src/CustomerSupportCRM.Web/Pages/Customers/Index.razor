@page "/customers"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Customers</PageTitle>

<div class="page-header">
    <h1>Customers</h1>
    <button class="btn btn-primary" @onclick="StartCreate">+ New customer</button>
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (_editing is not null)
{
    <div class="card p-3 mb-4">
        <h5>@(_editing.Id == Guid.Empty ? "New customer" : "Edit customer")</h5>
        <EditForm Model="_editing" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label">Full name</label>
                    <InputText class="form-control" @bind-Value="_editing.FullName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="_editing.Email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Phone</label>
                    <InputText class="form-control" @bind-Value="_editing.Phone" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Company</label>
                    <InputText class="form-control" @bind-Value="_editing.Company" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Notes</label>
                    <InputText class="form-control" @bind-Value="_editing.Notes" />
                </div>
            </div>

            @if (_fieldErrors is not null)
            {
                <ul class="field-error mt-2">
                    @foreach (var field in _fieldErrors)
                    {
                        @foreach (var msg in field.Value)
                        {
                            <li>@field.Key: @msg</li>
                        }
                    }
                </ul>
            }

            <div class="mt-3">
                <button class="btn btn-success" type="submit" disabled="@_saving">Save</button>
                <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Cancel</button>
            </div>
        </EditForm>
    </div>
}

@if (_loading)
{
    <p>Loading...</p>
}
else if (_customers.Count == 0)
{
    <p class="text-muted">No customers yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Tickets</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in _customers)
            {
                <tr>
                    <td>@customer.FullName</td>
                    <td>@customer.Email</td>
                    <td>@customer.Phone</td>
                    <td>@customer.Company</td>
                    <td>@customer.TicketCount</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(customer)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(customer)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CustomerDto> _customers = [];
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;
    private IReadOnlyDictionary<string, string[]>? _fieldErrors;
    private EditModel? _editing;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _customers = (await Api.GetCustomersAsync()).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartCreate()
    {
        _editing = new EditModel();
        _fieldErrors = null;
        _errorMessage = null;
    }

    private void StartEdit(CustomerDto customer)
    {
        _editing = new EditModel
        {
            Id = customer.Id,
            FullName = customer.FullName,
            Email = customer.Email,
            Phone = customer.Phone,
            Company = customer.Company,
            Notes = customer.Notes
        };
        _fieldErrors = null;
        _errorMessage = null;
    }

    private void CancelEdit() => _editing = null;

    private async Task SaveAsync()
    {
        if (_editing is null)
        {
            return;
        }

        _saving = true;
        _errorMessage = null;
        _fieldErrors = null;

        try
        {
            if (_editing.Id == Guid.Empty)
            {
                await Api.CreateCustomerAsync(new CreateCustomerRequest(
                    _editing.FullName, _editing.Email, _editing.Phone, _editing.Company, _editing.Notes));
            }
            else
            {
                await Api.UpdateCustomerAsync(_editing.Id, new UpdateCustomerRequest(
                    _editing.FullName, _editing.Email, _editing.Phone, _editing.Company, _editing.Notes));
            }

            _editing = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
            _fieldErrors = ex.FieldErrors;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(CustomerDto customer)
    {
        _errorMessage = null;
        try
        {
            await Api.DeleteCustomerAsync(customer.Id);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private class EditModel
    {
        public Guid Id { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string FullName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        public string? Phone { get; set; }
        public string? Company { get; set; }
        public string? Notes { get; set; }
    }
}
