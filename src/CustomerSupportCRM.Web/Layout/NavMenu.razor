@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Customer Support CRM (SDD)</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <AuthorizeView>
        <Authorized>
            <nav class="nav flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="customers">Customers</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tickets">Tickets</NavLink>
                </div>
                <div class="nav-item px-3">
                    <span class="nav-link">Signed in as @context.User.Identity?.Name</span>
                </div>
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link text-start" style="padding-left:0" @onclick="LogoutAsync">
                        Log out
                    </button>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private async Task LogoutAsync()
    {
        await AuthProvider.NotifyUserLogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: false);
    }
}
